filters:
  and:
    - file.inFolder("02 Team Research")
    - not:
        - file.path.contains("/_templates/")
views:
  - type: table
    name: Roster
    filters:
      and:
        - 'type == "member"'
    order:
      - file.name
      - note.name
      - note.role
      - note.university
      - note.lead
      - note.focus
      - note.status
  - type: table
    name: Tasks
    filters:
      and:
        - 'type == "task"'
    groupBy:
      property: note.owner
      direction: ASC
    order:
      - file.name
      - note.status
      - note.priority
      - note.due
      - note.closes
  - type: table
    name: Findings
    filters:
      and:
        - 'type == "finding"'
    order:
      - file.name
      - note.owner
      - note.status
      - note.confidence
      - note.workstreams
      - note.updates
  - type: table
    name: Interviews
    filters:
      and:
        - 'type == "interview"'
    order:
      - file.name
      - note.owner
      - note.date
      - note.segment
      - note.hypotheses
      - note.verdicts
      - note.spend_eur_year
  - type: table
    name: Projects
    filters:
      and:
        - 'type == "project"'
    order:
      - file.name
      - note.owner
      - note.holder
      - note.holder_cui
      - note.county
      - note.mw_ac
      - note.mwp_dc
      - note.build_stage
      - note.match_confidence
      - note.minutes_spent
  - type: table
    name: Sources
    filters:
      and:
        - 'type == "source"'
    order:
      - file.name
      - note.owner
      - note.publisher
      - note.date_published
      - note.source_type
      - note.access
  - type: table
    name: Candidates
    filters:
      and:
        - 'type == "candidate"'
    groupBy:
      property: note.verdict
      direction: ASC
    order:
      - file.name
      - note.owner
      - note.county
      - note.first_clear_after
      - note.signal
      - note.area_ha
      - note.linked_project
